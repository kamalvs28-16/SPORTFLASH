# ------------------------------------------------------------------------------
videos/
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.flv
*.wmv
*.m4v
*.avif

# Generated heatmaps and temporary plots
*_heatmap.png
results/*_heatmap.png

# User uploaded player photos & sprint drill test videos (keep folders clean)
results/player_photos/*
!results/player_photos/.gitkeep
backend/results/player_photos/*
!backend/results/player_photos/.gitkeep

# ------------------------------------------------------------------------------
